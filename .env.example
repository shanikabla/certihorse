# --- Database (Neon postgres in prod, local docker in dev) ---
# Pooled connection (used by app at runtime)
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"
# Direct connection (used by Prisma migrations only — bypasses the pooler)
DIRECT_URL="postgresql://user:pass@host/dbname?sslmode=require"

# --- Auth.js v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public canonical URL of the app (used for callbacks / emails)
AUTH_URL="http://localhost:3000"

# Comma-separated list of emails that are auto-promoted to ADMIN on login.
# This is the team backoffice — DO NOT expose ADMIN in the public signup.
# Adding an email here promotes; removing does NOT auto-demote (safety).
ADMIN_EMAILS=""

# --- Cloudflare R2 (S3-compatible object storage) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="certihorse-dev"
# e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=""
# Optional public bucket URL (for non-sensitive assets only)
R2_PUBLIC_BASE_URL=""

# --- Stripe (Billing for VET_PRO / SELLER_PRO subscriptions) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Prices — set after creating products in Stripe
STRIPE_PRICE_VET_PRO_MONTHLY=""
STRIPE_PRICE_VET_PRO_YEARLY=""
STRIPE_PRICE_SELLER_PRO_MONTHLY=""

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Certihorse <noreply@certihorse.com>"

# --- Feature flags ---
# Pilier 4 — traçabilité par consentement (à activer après validation juridique)
FEATURE_PILIER_4="false"
